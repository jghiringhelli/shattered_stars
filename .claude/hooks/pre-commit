#!/usr/bin/env bash
# Master pre-commit dispatcher — runs all pre-commit-*.sh hooks in order.
# Add new hooks by dropping a pre-commit-<name>.sh file in this directory.
set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for hook in "$HOOKS_DIR"/pre-commit-*.sh; do
  [ -x "$hook" ] || chmod +x "$hook"
  "$hook" || exit 1
done

exit 0
