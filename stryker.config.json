{
  "$schema": "https://stryker-mutator.io/schemas/stryker-schema.json#",
  "testRunner": "vitest",
  "testRunner_options_comment": "configFile passed via vitest.config.ts autodiscovery",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/systems/CombatSystem.ts",
    "src/systems/ActionsSystem.ts",
    "src/systems/OrdnanceSystem.ts",
    "src/core/errors.ts"
  ],
  "testFiles": [
    "tests/unit/systems/CombatSystem.test.ts",
    "tests/unit/systems/ActionsSystem.test.ts",
    "tests/unit/systems/OrdnanceSystem.test.ts",
    "tests/unit/systems/TurretSystem.test.ts",
    "tests/unit/core/errors.test.ts",
    "tests/unit/EdgeCases.test.ts"
  ],
  "tempDirName": "stryker-tmp",
  "concurrency": 2,
  "timeoutMS": 30000,
  "timeoutFactor": 2,
  "reporters": ["progress", "clear-text"],
  "ignorePatterns": ["node_modules", "dist", "stryker-tmp"],
  "coverageAnalysis": "perTest",
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@stryker-mutator/typescript-checker"
  ]
}
