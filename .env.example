NODE_ENV=development
LOG_LEVEL=info

# Online play (client, read at build time by Vite)
# Relay WebSocket address; dev builds fall back to ws://localhost:8080/ws (npm run start:server).
VITE_ONLINE_URL=
# Build id players must share to be matched (CI sets the commit SHA).
VITE_GAME_BUILD=

# Relay server (server/src/config.ts documents every variable)
PORT=8080
ALLOWED_ORIGINS=*
RECONNECT_WINDOW_MS=30000
