NODE_ENV=development
LOG_LEVEL=info

# Online play (client, read at build time by Vite)
# Relay WebSocket address; dev builds fall back to ws://localhost:8080/ws (npm run start:server).
VITE_ONLINE_URL=
# Where SEND FEEDBACK sends testers (read at build time by Vite).
# Empty = the repository's GitHub new-issue page, prefilled with the build and mode.
# Any http(s) form URL also works; these placeholders are replaced with URL-encoded values:
# {version} {commit} {mode} {scene} {kind} {title} {body}, e.g.
#   https://forms.example.com/f/abc?build={version}&mode={mode}&type={kind}
VITE_FEEDBACK_URL=

# Build id players must share to be matched (CI sets the commit SHA).
VITE_GAME_BUILD=

# Relay server (server/src/config.ts documents every variable)
PORT=8080
# Local dev only: production (NODE_ENV=production) requires an explicit origin list, e.g. https://user.github.io
ALLOWED_ORIGINS=*
# Set to true only behind a trusted reverse proxy (Fly, Render): otherwise X-Forwarded-For is ignored.
TRUST_PROXY=false
RECONNECT_WINDOW_MS=30000
