{
  "name": "shattered-stars",
  "version": "0.2.0-beta.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "Tactical dogfighting arcade game inspired by classic starfighter combat games",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "check:cycles": "tsx scripts/check_import_cycles.ts",
    "quality": "tsx scripts/quality_check.ts --list",
    "quality:check": "tsx scripts/quality_check.ts --check",
    "quality:baseline": "tsx scripts/quality_check.ts --update-baseline",
    "verify:full": "npm run typecheck:all && npm run lint && npm run check:cycles && npm run quality:check && vitest run --coverage && npm run test:skill",
    "i18n:extract": "tsx scripts/i18n_extract.ts",
    "hooks:setup": "bash scripts/setup-hooks.sh",
    "measure:first-load": "tsx scripts/measure_first_load.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit tests/balance tests/simulation",
    "test:coverage": "vitest run --coverage",
    "test:skill": "vitest run --config vitest.skill.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "qa:gameplay": "npx tsx scripts/gameplay_vision_qa.ts",
    "analyze:telemetry": "tsx scripts/analyze_telemetry.ts",
    "movement:lab": "tsx scripts/movement_lab.ts",
    "profile:ai": "tsx scripts/ai_behaviour_profile.ts",
    "telemetry:weapons": "tsx scripts/weapon_telemetry.ts",
    "telemetry:ships": "tsx scripts/ship_efficiency.ts",
    "telemetry:hitrate": "tsx scripts/arcade_hitrate.ts",
    "telemetry:aura": "tsx scripts/aura_uptime.ts",
    "telemetry:report": "tsx scripts/telemetry_report.ts",
    "telemetry:tempo": "tsx scripts/telemetry_tempo.ts",
    "telemetry:survival": "tsx scripts/telemetry_survival.ts",
    "sentinel": "tsx scripts/sentinel.ts",
    "verify:loop": "tsx scripts/verify_loop.ts",
    "playthrough:director": "tsx scripts/playthrough_director.ts",
    "balance:roles": "tsx scripts/role_matchup_matrix.ts",
    "balance:report": "tsx scripts/balance_report.ts",
    "start:server": "tsx server/src/main.ts",
    "build:server": "esbuild server/src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=server/dist/server.cjs --external:bufferutil --external:utf-8-validate",
    "measure:net": "tsx scripts/net_measure.ts"
  },
  "dependencies": {
    "@types/seedrandom": "^3.0.8",
    "immer": "^10.1.1",
    "phaser": "^3.87.0",
    "seedrandom": "^3.0.5",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "happy-dom": "^20.8.3",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^2.1.9"
  }
}
